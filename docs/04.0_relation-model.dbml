// Modelo relacional físico PostgreSQL. Tablas y columnas usan snake_case.
// Modelos Prisma singulares se mapean a tablas PostgreSQL plurales con @@map.
// Patient -> patients; Doctor -> doctors; Specialty -> specialties;
// Appointment -> appointments; User -> users.
// firstName -> first_name; lastName -> last_name; birthDate -> birth_date;
// specialtyId -> specialty_id; userId -> user_id; patientId -> patient_id;
// doctorId -> doctor_id; scheduledAt -> scheduled_at.

Enum AppointmentStatus {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

Enum Role {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}

Table patients {
  id int [pk, increment]
  first_name varchar [not null]
  last_name varchar [not null]
  email varchar [not null]
  birth_date date [not null]
}

Table specialties {
  id int [pk, increment]
  name varchar [not null]
}

Table users {
  id int [pk, increment]
  email varchar [not null, unique]
  password varchar [not null]
  role Role [not null]
}

Table doctors {
  id int [pk, increment]
  first_name varchar [not null]
  last_name varchar [not null]
  specialty_id int [not null]
  user_id int [unique, null]
}

Table appointments {
  id int [pk, increment]
  patient_id int [not null]
  doctor_id int [not null]
  scheduled_at timestamptz(3) [not null]
  reason varchar [null]
  status AppointmentStatus [not null, default: 'PROGRAMADA']

  Indexes {
    (doctor_id, scheduled_at) [unique]
    (patient_id, scheduled_at) [unique]
  }
}

Ref: doctors.specialty_id > specialties.id
Ref: appointments.patient_id > patients.id
Ref: appointments.doctor_id > doctors.id
Ref: doctors.user_id - users.id
