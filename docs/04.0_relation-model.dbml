// Modelo relacional PostgreSQL conforme a prisma/schema.prisma
// y prisma/migrations/20261115014117_init/migration.sql.
// Los nombres de tabla/campo siguen el DDL generado. Prisma
// Appointment.scheduledAt corresponde a la columna física startAt.

Enum AppointmentStatus {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

Enum UserRole {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}

Table Patient {
  id uuid [pk]
  firstName text [not null]
  lastName text [not null]
  email text [not null, unique]
  birthDate date [not null]
  phone text
}

Table Specialty {
  id uuid [pk]
  name text [not null, unique]
}

Table Doctor {
  id uuid [pk]
  firstName text [not null]
  lastName text [not null]
  professionalLicense text [not null, unique]
  email text
  specialtyId uuid [not null]
}

Table Appointment {
  id uuid [pk]
  patientId uuid [not null]
  doctorId uuid [not null]
  startAt timestamptz(6) [not null, note: 'Prisma field: scheduledAt']
  reason text
  status AppointmentStatus [not null, default: 'PROGRAMADA']

  Indexes {
    (doctorId, startAt)
    (patientId, startAt)
    (status, startAt)
  }
}

Table User {
  id uuid [pk]
  email text [not null, unique]
  passwordHash text [not null]
  role UserRole [not null]
  doctorId uuid [unique]
}

Ref: Doctor.specialtyId > Specialty.id
Ref: Appointment.patientId > Patient.id
Ref: Appointment.doctorId > Doctor.id
Ref: User.doctorId - Doctor.id
